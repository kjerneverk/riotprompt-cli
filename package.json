{
  "name": "@riotprompt/riotprompt-cli",
  "version": "1.0.0-dev.0",
  "description": "CLI for RiotPrompt - process and execute prompts",
  "type": "module",
  "bin": {
    "riotprompt": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "vite build",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "precommit": "npm run lint && npm run test",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "cli",
    "prompt",
    "llm",
    "ai",
    "riotprompt"
  ],
  "author": "Tim O'Brien <tobrien@discursive.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kjerneverk/riotprompt-cli"
  },
  "dependencies": {
    "@theunwalked/cardigantime": "^0.0.22",
    "@theunwalked/spotclean": "^0.0.3",
    "chalk": "^5.4.1",
    "commander": "^14.0.2"
  },
  "peerDependencies": {
    "@riotprompt/execution-anthropic": "^1.0.0",
    "@riotprompt/execution-gemini": "^1.0.0",
    "@riotprompt/execution-openai": "^1.0.0",
    "@riotprompt/riotprompt": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@riotprompt/riotprompt": {
      "optional": true
    },
    "@riotprompt/execution-openai": {
      "optional": true
    },
    "@riotprompt/execution-anthropic": {
      "optional": true
    },
    "@riotprompt/execution-gemini": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.28.0",
    "globals": "^17.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
